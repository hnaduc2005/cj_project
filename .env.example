# Copy to .env on a new installation. Never commit .env.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/purchase.sqlite
APP_URL=http://127.0.0.1:3000
# Initial password for uyenthu.cu@cj.net; only used when account does not exist.
# The delivered machine already has the requested account configured.
BOOTSTRAP_ADMIN_PASSWORD=
# Company Entra application: confidential Web client, single tenant.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Enable only after IT grants/scopes Graph Mail.Send Application permissions.
MAIL_ENABLED=false

# Gmail relay: run SETUP-GMAIL.cmd after creating the mailbox and an App Password.
MAIL_PROVIDER=GMAIL
GMAIL_USER=prc.cjgmd@gmail.com
GMAIL_APP_PASSWORD=
